\begin_layout Standard
Dynamics in the interaction picture of the bath.
 We call 
\emph on
bath
\emph default
 the set of non-interacting orbitals of the problem.
 Applying Trotter formula up to order 
\begin_inset Formula $dt^{2}$
\end_inset

 we have
\begin_inset Formula 
\[
\exp(-\imath\hat{H}dt)=\exp(-\imath\hat{H}_{\text{bath}}dt)\exp(-\imath\hat{H}^{(2)}dt)+O(dt^{3})
\]

\end_inset

 with 
\begin_inset Formula $\hat{H}^{(2)}=\hat{H}-\hat{H}_{\text{bath}}-idt[\hat{H},\hat{H}_{\text{bath}}]/2$
\end_inset

.
 
\end_layout

\begin_layout Standard
We need this commutator for a quadratic Hamiltonian with coefficients 
\begin_inset Formula $t_{ij}$
\end_inset

.
 We have:
\begin_inset Formula 
\begin{equation}
\begin{alignedat}{1}[H,H_{bath}] & =t_{\alpha i}t_{jk}\left\{ [c_{\alpha}^{\dagger}c_{i},c_{j}^{\dagger}c_{k}]+[c_{i}^{\dagger}c_{\alpha},c_{j}^{\dagger}c_{k}]\right\} \\
 & =t_{\alpha i}t_{jk}\left\{ c_{\alpha}^{\dagger}c_{k}\delta_{ij}-c_{j}^{\dagger}c_{\alpha}\delta_{ik}\right\} \\
 & =t_{\alpha i}t_{ik}c_{\alpha}^{\dagger}c_{k}-t_{\alpha i}t_{ji}c_{j}^{\dagger}c_{\alpha}\\
 & =t_{\alpha i}t_{ij}\left\{ c_{\alpha}^{\dagger}c_{j}-c_{j}^{\dagger}c_{\alpha}\right\} 
\end{alignedat}
\end{equation}

\end_inset


\end_layout

