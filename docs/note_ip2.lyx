\begin_layout Subsection
Interaction picture
\end_layout

\begin_layout Standard
The general anzats for the quantum state is
\begin_inset Formula 
\[
\phi=\exp(-iH_{\text{bath}}t)\exp(-iF)\psi
\]

\end_inset

where 
\begin_inset Formula $t$
\end_inset

 is the time and 
\begin_inset Formula $F$
\end_inset

 is a quadratic Hamiltonian (representing the current frame) which depend
 on time.
 The effective state 
\begin_inset Formula $\psi$
\end_inset

 is expected to be low entangled (ideally for MPS).
 
\end_layout

\begin_layout Standard
The expression for time evolution 
\begin_inset Formula $dt=\tau$
\end_inset

 with a Hamiltonian 
\begin_inset Formula $H=H_{b}+H_{imp}$
\end_inset

is
\begin_inset Formula 
\[
\phi^{n+1}=\exp(-i(n+1)H_{b})\exp(-iF^{n})\exp(H_{\text{eff}}^{n})\psi^{n}\text{, where }
\]

\end_inset


\begin_inset Formula 
\[
H_{\text{eff}}^{n}=\exp(iF^{n})H_{\text{ip}}^{n}\exp(-iF^{n})
\]

\end_inset


\begin_inset Formula 
\[
H_{\text{ip}}^{n}=\exp(iH_{b}n)H_{\text{ip}}\exp(-iH_{b}n)
\]

\end_inset


\begin_inset Formula 
\[
H_{\text{ip}}=H-H_{\text{bath}}-i\tau/2[H,H_{b}]
\]

\end_inset


\end_layout

